# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database (Railway PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────
# GROQ_MODEL OVERRIDES the code default in src/services/groqService.js.
# If you change the code default and this var is set on Railway, the var wins.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# ── Verra public registry ingest ──────────────────────────────────────────
# Base URL for the public (unauthenticated) Verra registry project API.
# Left blank by default: the ingest job is OFF until this is set deliberately,
# so a fresh deploy never starts hammering a third party by accident.
VERRA_API_BASE=
VERRA_INGEST_ENABLED=false
